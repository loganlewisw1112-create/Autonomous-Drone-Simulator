# MapLibre tile source — uses free OpenStreetMap tiles by default, no key needed
# To use Maptiler (satellite tiles), get a free key at https://cloud.maptiler.com
VITE_MAPTILER_KEY=

# Simulation seed override (optional — scenario YAML takes precedence)
VITE_DEFAULT_SEED=42

# Optional: override classroom WebSocket URL (advanced). Default is same-origin.
# VITE_CLASSROOM_WS_URL=

# Optional: preferred relay base URL for the web Yes/probe dialog (e.g. http://127.0.0.1:8080).
# Browser/Vercel builds only probe — they never spawn the Node relay.
# VITE_CLASSROOM_RELAY_URL=

# Distribution policy. Vercel demos use public_demo (30-minute wall clock,
# 10-minute idle, 15-minute debrief). The packaged classroom host uses
# licensed_windows; its 14/90-day term and 72-hour offline lease come only from
# the signed Electron entitlement and never from renderer storage/build dates.
# VITE_DISTRIBUTION_CHANNEL=licensed_windows

# Public production licence configuration is packaged by the Windows release
# workflow. Private signing/HMAC/database values belong only to the independent
# licence-service deployment and must never use a VITE_ prefix.
# LICENSING_API_URL=https://<independent-licence-project>.vercel.app
# LICENSING_ISSUER=https://<independent-licence-project>.vercel.app
# LICENSING_JWS_KEY_ID=<current-public-key-id>
# LICENSING_JWS_PUBLIC_KEY_SPKI_BASE64=<base64-ed25519-public-spki>
